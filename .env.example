# === AI先生 環境変数 ===
# ローカルでは .env.local に、Vercelでは Project Settings > Environment Variables に設定。

# OpenAI APIキー（サーバー側のみ。必須。未設定でもアプリは「練習モード」で起動する）
OPENAI_API_KEY=

# 使用モデル（任意・既定値あり）
# OPENAI_MODEL=gpt-4o
# OPENAI_MODERATION_MODEL=gpt-4o-mini

# 会話ログの保存先（任意）。
# Vercel等のサーバーレスで永続ログを残すには Postgres の接続URLを設定する（Supabase/Neon等）。
# 未設定の場合: ローカルはSQLite、Vercel上はログ無し(noop)で動作する。
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# SQLiteの保存先（ローカルのみ・任意）
# SQLITE_PATH=./data/ai-sensei.db

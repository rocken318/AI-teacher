# === AI先生 環境変数 ===
# ローカルでは .env.local に、Vercelでは Project Settings > Environment Variables に設定。

# OpenAI APIキー（サーバー側のみ。必須。未設定でもアプリは「練習モード」で起動する）
OPENAI_API_KEY=

# 使用モデル（任意・既定値あり）。コスト方針: 基本は安いモデル、上位は課金ティア。
# OPENAI_MODEL=gpt-4o-mini            # 無料ティアの対話（既定・安い）
# OPENAI_MODERATION_MODEL=gpt-4o-mini # 入出力モデレーション（常に安く）
# OPENAI_PREMIUM_MODEL=gpt-4o         # 課金ティア「じっくりモード」の対話（上位）

# 会話ログの保存先（任意）。推奨は Supabase の Postgres。
# 未設定の場合: ローカルはSQLite、Vercel上はログ無し(noop)で動作する。
# ★Vercel(サーバーレス)では Supabase の「Transaction Pooler」接続文字列(:6543)を使うこと。
#   Supabase > Project Settings > Database > Connection string > "Transaction pooler" をコピー。
#   （コード側で prepared statements 無効化・接続数1に設定済み）
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# SQLiteの保存先（ローカルのみ・任意）
# SQLITE_PATH=./data/ai-sensei.db
